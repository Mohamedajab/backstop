{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backstop",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "ratelimits": [{ "name": "REQUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "services": [{ "binding": "ORIGIN", "service": "backstop-fixture" }],
  "durable_objects": {
    "bindings": [{ "name": "RESOURCES", "class_name": "ResourceCache" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ResourceCache"] }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
